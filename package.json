{
  "name": "gh-cdk-connectivity",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable GitHub Actions to AWS CDK connectivity test (OIDC, no static keys)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "synth": "cdk synth -c env=dev",
    "diff": "cdk diff -c env=dev",
    "deploy": "cdk deploy -c env=dev",
    "destroy": "cdk destroy -c env=dev"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.1000.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  }
}
